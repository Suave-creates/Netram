# Copy to .env and fill in locally. Never commit real keys.

# --- eyewear-fit-api (docker compose service: api) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Mounted from ./data inside the container
GUIDELINES_PATH=/app/data/Eyewear_Fit_Standard_Guidelines.xlsx

HOST=0.0.0.0
PORT=8000

# --- optional static frontend profile ---
FRONTEND_PORT=5173

# --- client integration (your consuming service) ---
EYEWEAR_FIT_API_URL=http://127.0.0.1:8000
